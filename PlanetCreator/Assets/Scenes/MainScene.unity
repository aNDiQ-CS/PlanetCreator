  m_text: "\u0412 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0430\u0445 \u043A\u043E\u0441\u043C\u043E\u0441\u0430
    \u043F\u043B\u0430\u043D\u0435\u0442\u044B \u2014 \u0432\u0441\u0435\u0433\u043E
    \u043B\u0438\u0448\u044C \u043F\u0435\u0441\u0447\u0438\u043D\u043A\u0438, \u0438\u0433\u0440\u0430\u044E\u0449\u0438\u0435
    \u043D\u0435\u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u0440\u043E\u043B\u044C \u0432 \u0433\u0440\u0430\u043D\u0434\u0438\u043E\u0437\u043D\u043E\u0439
    \u043A\u0430\u0440\u0442\u0438\u043D\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0445 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432.
    \u041E\u0434\u043D\u0430\u043A\u043E \u044D\u0442\u043E \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
    \u0440\u0430\u0437\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435
    \u0438 \u0441\u043B\u043E\u0436\u043D\u044B\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B
    \u0412\u0441\u0435\u043B\u0435\u043D\u043D\u043E\u0439. \u041D\u0438 \u0443 \u043E\u0434\u043D\u043E\u0433\u043E

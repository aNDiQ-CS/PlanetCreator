      propertyPath: typingSpeed
      value: 0.04
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: worldCamera
      value: 
      objectReference: {fileID: 699378263}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_startDelay
      value: 1.2
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[0].text
      value: "\u0412\u0441\u0435 \u044D\u0442\u0430\u043F\u044B \u043F\u043E\u0437\u0430\u0434\u0438,
        \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043D\u0430\u044F
        \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
        \u0430\u043D\u0430\u043B\u0438\u0437 \u043E\u0442\u0432\u0435\u0442\u043E\u0432!
        \u0421\u043E\u0432\u0441\u0435\u043C \u0441\u043A\u043E\u0440\u043E \u043C\u044B
        \u0443\u0432\u0438\u0434\u0438\u043C, \u043A\u0430\u043A\u0430\u044F \u043F\u043B\u0430\u043D\u0435\u0442\u0430
        \u0440\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u0432 \u0445\u043E\u0434\u0435
        \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430!"
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[1].text
      value: "\u0421\u0431\u043E\u0440 \u0434\u0430\u043D\u043D\u044B\u0445. \u0421\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044F
        \u043F\u043E\u0434\u0432\u043E\u0434\u0438\u0442 \u0438\u0442\u043E\u0433\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[2].text
      value: "\u041F\u043E \u043E\u0434\u043D\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
        \u043B\u0438\u043D\u0438\u0438 \u2013 \u0436\u0430\u0440\u043A\u0438\u0435
        \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435 \u043C\u0438\u0440\u044B,
        \u043F\u043E \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443
        \u2013 \u0446\u0430\u0440\u0441\u0442\u0432\u043E \u043B\u044C\u0434\u0430
        \u0438 \u0433\u0430\u0437\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[3].text
      value: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0435
        \u043C\u0435\u0441\u0442\u043E \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
        \u0432\u0430\u0448\u0435\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u044B
        \u0438\u0441\u0445\u043E\u0434\u044F \u0438\u0437 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0445
        \u0440\u0430\u043D\u0435\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432!"
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[0].label

      value: 
      objectReference: {fileID: 699378263}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: typingSpeed
      value: 0.04
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: worldCamera
      value: 
      objectReference: {fileID: 699378263}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[0].text
      value: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
        \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044E
        \u043E\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u0438
        \u0418\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
        \u043F\u0430\u0440\u043A\u0430 \xAB\u0420\u043E\u0441\u0441\u0438\u044F \u2013
        \u043C\u043E\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F\xBB, \u044E\u043D\u044B\u0439
        \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[1].text
      value: "\u0412 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
        \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u0437\u0432\u0435\u0437\u0434\u043E\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F
        \u0443\u0447\u0451\u043D\u044B\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F
        \u043C\u043E\u0434\u0435\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435\u043C
        \u0433\u0430\u0437\u043E\u043F\u044B\u043B\u0435\u0432\u044B\u0445 \u043F\u0440\u043E\u0442\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u044B\u0445
        \u0434\u0438\u0441\u043A\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442\u0441\u044F \u0432\u043E\u043A\u0440\u0443\u0433
        \u043C\u043E\u043B\u043E\u0434\u044B\u0445 \u0437\u0432\u0451\u0437\u0434."
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[2].text
      value: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C
        \u0431\u044B\u0442\u044C \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
        \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u0435\u043C,
        \u0430 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u043C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
        \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430
        \u0438 \u0441\u043E\u0437\u0434\u0430\u0448\u044C \u0441\u0432\u043E\u044E
        \u043F\u043B\u0430\u043D\u0435\u0442\u0443. \r"
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[3].text
      value: "\u041D\u043E \u043F\u0440\u0435\u0436\u0434\u0435, \u0434\u0430\u0432\u0430\u0439
        \u0441\u043E\u0437\u0434\u0430\u0434\u0438\u043C \u043C\u0435\u0436\u0437\u0432\u0435\u0437\u0434\u043D\u043E\u0435
        \u043E\u0431\u043B\u0430\u043A\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
        \u043B\u0435\u0436\u0438\u0442 \u0432 \u043E\u0441\u043D\u043E\u0432\u0435
        \u043F\u043B\u0430\u043D\u0435\u0442\u043E\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F!\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[4].text
      value: "\u0423 \u0442\u0435\u0431\u044F \u0443\u0436\u0435 \u0435\u0441\u0442\u044C
        \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0439
        \u0441\u043E\u0441\u0442\u0430\u0432..."
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[5].text
      value: "\u043E\u0434\u043D\u0430\u043A\u043E, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
        \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E \u0442\u0432\u043E\u0435\u043C\u0443
        \u043C\u043D\u0435\u043D\u0438\u044E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B
        \u0432 \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u0438
        \u0432 \u0442\u0432\u043E\u0435\u043C \u043F\u0440\u043E\u0442\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u043E\u043C
        \u0434\u0438\u0441\u043A\u0435!"
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[6].text
      value: "\u0411\u0443\u0434\u044C \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u043D,
        \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u043E\u0441\u0442\u0430\u0432
        \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0441\u0432\u043E\u0438\u043C\u0438
        \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044F\u043C\u0438
        \u0438 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430\u043C\u0438
        \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u043C
        \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u0439."
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[7].text
      value: "\u0412\u044B\u0431\u0435\u0440\u0438 3 \u0441\u043C\u0435\u0441\u0438.
        \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u0437 \u043D\u0438\u0445
        \u043B\u0443\u0447\u0448\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C
        \u0432 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[0].label

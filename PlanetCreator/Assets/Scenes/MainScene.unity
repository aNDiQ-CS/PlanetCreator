      propertyPath: m_startDelay
      value: 1.2
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[0].text
      value: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C\u0442\u0435
        \u0441\u0435\u0431\u0435 \u0434\u0432\u0430 \u0448\u0430\u0440\u0430 \u0441
        \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0439 \u043C\u0430\u0441\u0441\u043E\u0439:
        \u0448\u0430\u0440 \u0438\u0437 \u0436\u0435\u043B\u0435\u0437\u0430 \u0438
        \u0448\u0430\u0440 \u0438\u0437 \u043F\u0435\u043D\u043E\u043F\u043B\u0430\u0441\u0442\u0430.
        \u0428\u0430\u0440 \u0438\u0437 \u0436\u0435\u043B\u0435\u0437\u0430 \u0431\u0443\u0434\u0435\u0442
        \u043E\u0447\u0435\u043D\u044C \u043F\u043B\u043E\u0442\u043D\u044B\u043C
        \u0438, \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
        \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043F\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[1].text
      value: "\u0428\u0430\u0440 \u0438\u0437 \u043F\u0435\u043D\u043E\u043F\u043B\u0430\u0441\u0442\u0430
        \u0438\u043C\u0435\u0435\u0442 \u043E\u0447\u0435\u043D\u044C \u043D\u0438\u0437\u043A\u0443\u044E
        \u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C \u0438, \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
        \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u043F\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0443"
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[2].text
      value: "\u0422\u043E \u0436\u0435 \u0441\u0430\u043C\u043E\u0435 \u0438 \u0441
        \u043F\u043B\u0430\u043D\u0435\u0442\u0430\u043C\u0438! \u0421\u043E\u0441\u0442\u0430\u0432
        \u043F\u043B\u0430\u043D\u0435\u0442\u044B \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438
        \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u0438\u0442\u043E\u0433\u043E\u0432\u044B\u0439
        \u0440\u0430\u0437\u043C\u0435\u0440 \u0438 \u0442\u0438\u043F \u043F\u043B\u0430\u043D\u0435\u0442\u044B
        \u043F\u0440\u0438 \u0437\u0430\u0434\u0430\u043D\u043D\u043E\u0439 \u043C\u0430\u0441\u0441\u0435!"
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[3].text
      value: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0437\u0430\u0434\u0430\u0434\u0438\u043C
        \u0412\u0430\u0448\u0438 \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u0435
        \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
        \u043A\u0430\u043A \u043E\u043D\u0438 \u043F\u043E\u0432\u043B\u0438\u044F\u044E\u0442
        \u043D\u0430 \u0438\u0442\u043E\u0433\u043E\u0432\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442?"
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[0].label

    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[0].text
      value: "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u043D\u0430 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0435
        \u0437\u043D\u0430\u0435\u0448\u044C, \u043A\u0430\u043A \u0441\u043B\u043E\u0436\u0435\u043D
        \u0438 \u0434\u043E\u043B\u043E\u0433 \u043F\u0440\u043E\u0446\u0435\u0441\u0441
        \u043F\u043B\u0430\u043D\u0435\u0442\u043E\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[1].text
      value: "\u0422\u044B \u043F\u043E\u0447\u0442\u0438 \u0443 \u0446\u0435\u043B\u0438.
        \u041E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u044D\u0442\u0430\u043F!"
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[2].text
      value: "\u041A\u043E\u0433\u0434\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0430
        \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F, \u0435\u0451
        \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u043E\u0440\u0431\u0438\u0442\u0430
        \u043C\u043E\u0436\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
        \u043E\u0442\u043B\u0438\u0447\u0430\u0442\u044C\u0441\u044F \u043E\u0442
        \u0442\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043E\u043D\u0430
        \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u0432 \u0437\u0440\u0435\u043B\u043E\u0439
        \u0437\u0432\u0451\u0437\u0434\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[3].text
      value: "\u041F\u043E\u0434 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C
        \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0444\u0430\u043A\u0442\u043E\u0440\u043E\u0432,
        \u043F\u043B\u0430\u043D\u0435\u0442\u044B \u043C\u043E\u0433\u0443\u0442
        \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0442\u044C\u0441\u044F
        \u0431\u043B\u0438\u0436\u0435 \u043A \u0437\u0432\u0435\u0437\u0434\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[4].text
      value: "\u042D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
        \u043F\u043B\u0430\u043D\u0435\u0442\u0443 \u0438\u043B\u0438 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
        \u0435\u0435 \u0442\u0438\u043F \u0438\u043B\u0438 \u0434\u0430\u0436\u0435
        \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u0435
        \u043C\u0438\u0440\u044B!"
      objectReference: {fileID: 0}
    - target: {fileID: 6449772558054984945, guid: 3bf5c30efc639a84f97dbf40b7736faf,
        type: 3}
      propertyPath: m_textDialogue.Array.data[5].text
      value: "\u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0442\u0432\u043E\u0435\u0439
        \u043F\u043B\u0430\u043D\u0435\u0442\u0435 \u043F\u043E\u0439\u0434\u0435\u0442
        \u043D\u0430 \u043F\u043E\u043B\u044C\u0437\u0443 \u043C\u0438\u0433\u0440\u0430\u0446\u0438\u044F?"
      objectReference: {fileID: 0}
